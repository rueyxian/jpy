#!/usr/bin/env zsh

get_venv_name_or_default() {
    local venv_name="$1"
    if [[ -z "$venv_name" ]]; then
        venv_name="venv"
    fi
    echo "$venv_name"
}

get_venv_dir() {
    local venv_name="$1"
    local venv_dir
    if [[ -z "$venv_name" ]]; then
        venv_dir="$(pwd)/venv"
    else
        venv_dir="$(pwd)/$venv_name"
    fi
    echo "$venv_dir"
}

is_venv() {
    local venv_dir="$1"
    if [ -f "$venv_dir/pyvenv.cfg" ] || \
       [ -f "$venv_dir/bin/python" ] || \
       [ -f "$venv_dir/Scripts/python.exe" ]; then
       return 0
    fi
    return 1
}


create_venv() {
    local OPTIND=1   # although this isn't required for zsh
    local opt
    local venv_name=".venv"
    local visible=0
    local install=0

    while getopts ":vif:" opt "$@"; do
        case $opt in
            v)
                visible=1
                ;;

            i)
                install=1
                ;;

            f)
                venv_name=".$OPTARG"
                ;;

            \?)
                echo "Invalid option: -$OPTARG"
                return 2
                ;;

        esac
    done

    if [[ "$visible" == 1 ]]; then
        venv_name="${venv_name:1}"
    fi
    local venv_dir=$(get_venv_dir "$venv_name")

    if [[ ! -e $venv_dir ]]; then
        virtualenv "$venv_dir"

    elif is_venv $venv_dir; then
        echo "NOOP: virtual environment '$venv_dir' exists"

    else
        echo "ERROR: path '$venv_dir' exists"
        return 1
    fi

    if [[ "$install" == 1 ]]; then
        local venv_activate="$venv_dir/bin/activate"
        source "$venv_activate"

        pip install --upgrade pip
        pip install --upgrade jupyterlab
        pip install --upgrade jupyterlab-lsp
        pip install 'python-lsp-server[all]'

        pip install --upgrade jupyterlab-code-formatter
        pip install --upgrade black isort
    fi

    return 0
}

activate_venv() {
    local _output="$1"
    shift

    local OPTIND=1 # although this isn't required for zsh
    local opt
    local venv_name="venv"
    local visible=0

    while getopts ":vf:" opt "$@"; do
        case $opt in
            v)
                visible=1
                ;;

            f)
                venv_name="$OPTARG"
                ;;

            \?)
                typeset -g "$_output"="Invalid option: -$OPTARG"
                return 2
                ;;

        esac
    done

    local dir1
    local dir2
    if [[ "$visible" == 0 ]]; then
        dir1=$(get_venv_dir ".$venv_name")
        dir2=$(get_venv_dir "$venv_name")
    elif; then
        dir1=$(get_venv_dir "$venv_name")
        dir2=$(get_venv_dir ".$venv_name")
    fi

    if [[ ! -z $VIRTUAL_ENV_PROMPT ]]; then
        deactivate
    fi

    # echo "dir1: $dir1"
    # echo "dir2: $dir2"

    if is_venv "$dir1"; then
        echo "dir1: $dir1"
        source "$dir1/bin/activate"
        return 0
    elif is_venv "$dir2"; then
        echo "dir2: $dir2"
        source "$dir2/bin/activate"
        return 0
    fi

    typeset -g "$_output"="ERROR: '$dir1' and '$dir2' not found."
    return 1
}

