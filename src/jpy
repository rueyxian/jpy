local cmd="$1"

if [[ -z "$cmd" ]]; then
    echo "ERROR: missing command" >&2
    exit 2
fi

if [[ "$cmd" == "create" || "$cmd" == "c" ]]; then
    local venv_name=$(get_venv_name_or_default "$2")
    local venv_dir=$(get_venv_dir "$venv_name")
    create_venv "$venv_dir"
    activate_venv "$venv_dir"

elif [[ "$cmd" == "activate" || "$cmd" == "a" ]]; then
    local venv_name=$(get_venv_name_or_default "$2")
    local venv_dir=$(get_venv_dir "$venv_name")
    activate_venv "$venv_dir"

elif [[ "$cmd" == "requirement" || "$cmd" == "r" ]]; then
    if [[ -z "$2" ]]; then
        requirement_dev
        requirement_proj

    elif [[ "$2" == "dev" ]]; then
        requirement_dev

    elif [[ "$2" == "proj" ]]; then
        requirement_proj

    fi


