#!/usr/bin/env zsh

local SRC_PATH=$XPY_PATH_SRC_SH

# source "$SRC_PATH/utils.sh"

get_venv_name_or_default() {
    local venv_name="$1"
    if [[ -z "$venv_name" ]]; then
        venv_name="venv"
    fi
    echo ".$venv_name"
}

get_venv_dir() {
    local venv_name="$1"
    local venv_dir
    if [[ -z "$venv_name" ]]; then
        venv_dir="$(pwd)/venv"
    else
        venv_dir="$(pwd)/$venv_name"
    fi
    echo "$venv_dir"
}

create_venv() {
    local venv_dir="$1"
    if [ -e $venv_dir ]; then
        echo "ERROR: '$venv_dir' exists" >&2
        exit 2
    fi
    virtualenv "$venv_dir"
}

activate_venv() {
    local venv_dir="$1"
    local venv_activate="$venv_dir/bin/activate"

    if [[ ! -f "$venv_activate" ]]; then
        echo "ERROR: '$venv_activate' not found" >&2
        exit 2
    fi
    if [[ ! -z $VIRTUAL_ENV_PROMPT ]]; then
        deactivate
    fi
    source $venv_activate
}

