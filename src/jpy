main() {
    local cmd=$1
    shift
    if [[ -z "$cmd" ]]; then
        echo "ERROR: missing command."
        return 2
    fi

    local output
    local errno
    case "$cmd" in
        create||c)
            output=$(create_venv "$@")
            errno="$?"
            ;;

        activate||a)
            activate_venv output "$@"
            errno="$?"
            ;;

        requirement||r)
            if [[ -z "$2" ]]; then
                requirement_dev
                requirement_proj

            elif [[ "$2" == "dev" ]]; then
                requirement_dev

            elif [[ "$2" == "proj" ]]; then
                requirement_proj

            fi
            ;;

        jupyter||j)
            output=$(run_jupyter "$@")
            errno="$?"
            ;;
        *)
            output="ERROR: Unknown command '$cmd'."
            errno=2
            ;;
    esac


    if [[ ! -z "$output" ]]; then
        echo "$output"
    fi
    if [[ "$errno" != 0 ]]; then
        return "$errno" || exit "$errno"
    fi
   
}

main "$@"



